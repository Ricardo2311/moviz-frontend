# Example environment variables
REACT_APP_API_URL=http://localhost:8000

# Monetização — valores PÚBLICOS por natureza (vão no app); nunca coloque chave secreta aqui.
# AdMob: IDs de TESTE do Google até a conta AdMob existir. Troque e ponha TESTING=false no lançamento.
REACT_APP_ADMOB_TESTING=true
REACT_APP_ADMOB_REWARDED_ANDROID=ca-app-pub-3940256099942544/5224354917
REACT_APP_ADMOB_REWARDED_IOS=ca-app-pub-3940256099942544/1712485313
# RevenueCat: chaves públicas do SDK (goog_... / appl_...). Vazio = compra desativada no app.
REACT_APP_REVENUECAT_ANDROID_KEY=
REACT_APP_REVENUECAT_IOS_KEY=